      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "katsu-config installs dependencies pinned to the exact versions used by this package's own package.json (e.g. typescript, vitest, @vitest/coverage-v8) so generated projects are reproducible."
    },
    {
      "id": "docs_cli_katsu_config_cross_platform_support",
      "label": "Cross-Platform Support Principle",
      "file_type": "rationale",
      "source_file": "docs/cli/katsu-config.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The CLI must run on Windows, Linux, and macOS; this drives the CommonJS package format for maximum compatibility, npx/pnpm dlx invocation paths, and PowerShell/Command Prompt guidance."
    },
    {
