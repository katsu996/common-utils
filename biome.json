{
  "extends": ["./biome.base.json"],
  "files": {
    "includes": [
      "!vite.config.base.ts",
      "!vite.config.template.ts",
      "!vite.config.ts",
      "!vitest.config.base.ts",
      "!vitest.config.template.ts",
      "!vitest.config.ts"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
