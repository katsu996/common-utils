{
  "name": " @katsu996/common-utils",
  "version": "0.1.0",
  "description": "A collection of common utility functions and shared configurations for projects within our organization.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.mjs",
      "require": "./dist/math.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "import": "./dist/string.mjs",
      "require": "./dist/string.js"
    },
    "./package.json": "./package.json",
    "./biome": "./biome.json",
    "./tsconfig": "./tsconfig.json"
  },
  "bin": {
    "katsu-init-config": "bin/init-config.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katsu996/common-utils.git"
  },
  "keywords": ["utility", "common", "shared", "typescript", "lint", "config", "utils", "katsu996"],
  "files": ["dist", "package.json", "README.md", "LICENSE", "biome.json", "tsconfig.json", "bin/"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --project tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "@biomejs/biome": "^1.7.0"
  }
}
