{
  "name": "@katsu996/common-utils",
  "version": "0.1.0",
  "description": "A collection of common utility functions and shared configurations for projects within our organization.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "require": "./dist/math.js"
    },
    "./package.json": "./package.json",
    "./biome": "./biome.base.json",
    "./tsconfig": "./tsconfig.json"
  },
  "bin": {
    "katsu-init-config": "bin/init-config.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katsu996/common-utils.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@types/node": "22.16.3",
    "npm-run-all": "4.1.5",
    "typescript": "5.8.3",
    "vite": "7.0.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.12.4"
  }
}