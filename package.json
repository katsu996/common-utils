{
  "name": "@katsu996/common-utils",
  "version": "1.1.12",
  "description": "A collection of common utility functions and shared configurations for projects within our organization.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "// Development": "=======================================",
    "dev": "vite",
    "// Build": "=============================================",
    "build": "vite build",
    "// Code Quality": "======================================",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "// Testing": "===========================================",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "// Utilities": "=========================================",
    "audit": "pnpm audit",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "files": [
    ".gitignore.template",
    "dist",
    "bin",
    "biome.base.jsonc",
    "mise.toml",
    "tsconfig.base.json",
    "vite.config.base.ts",
    "vitest.config.base.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "require": "./dist/math.js",
      "import": "./dist/math.js"
    },
    "./package.json": "./package.json",
    "./biome": "./biome.base.jsonc",
    "./mise": "./mise.toml",
    "./tsconfig": "./tsconfig.base.json",
    "./vite": "./vite.config.base.ts",
    "./vitest": "./vitest.config.base.ts"
  },
  "bin": {
    "katsu-config": "./bin/config.js"
  },
  "preferGlobal": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katsu996/common-utils.git"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23.1",
    "pnpm": ">=10.34.5"
  }
}
